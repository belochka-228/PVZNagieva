<Window x:Class="WPF_Nagieva.Pages.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Nagieva.Pages"
        mc:Ignorable="d"
        Title="HistoryWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CbSort" Width="200" Height="30" SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="Сначала новые" IsSelected="True"/>
                <ComboBoxItem Content="Сначала старые"/>
            </ComboBox>
        </StackPanel>

        <ListView x:Name="LvOrders" Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="5" BorderBrush="LightGray" BorderThickness="1" Padding="5">
                            <StackPanel>
                                <Grid Width="700">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="DarkGreen" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat='{}{0:C}'}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="20,10,0,0">
                            <TextBlock Text="{Binding DeliveryType, StringFormat='Доставка: {0}'}" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding DeliveryAddress, StringFormat='Адрес: {0}'}" Foreground="Gray" Margin="0,0,0,10"/>

                            <Grid Width="600" Margin="2,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Товар" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Grid.Column="1" Text="Кол-во" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Цена" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="#f9f9f9">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="600" Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceAtPurchase, StringFormat='{}{0:C}'}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>