<Window x:Class="WPF_Nagieva.Pages.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Nagieva.Pages"
        mc:Ignorable="d"
        Title="FavoritesWindow" Height="450" Width="800">
    <Grid Margin="10">
        <ListView x:Name="LvFavorites" BorderBrush="LightGray" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="60" Height="60" Stretch="Uniform" Source="{Binding ImagePath}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" Foreground="DarkGreen" FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="В корзину" Margin="5" Click="BtnMoveToCart_Click"/>
                        <Button Grid.Column="3" Content="Удалить" Margin="5" Background="#FFE4E1" Click="BtnRemove_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>