<Page x:Class="WPF_Nagieva.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="TxtSearch" Width="250" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="BtnSearch" Content="Найти" Width="100" Height="35" Click="BtnSearch_Click"/>
        </StackPanel>

        <ListView x:Name="LvProducts" Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="100" Height="100" Stretch="Uniform" Source="{Binding ImagePath}"/>

                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" MaxHeight="45" Margin="0,5"/>
                            <TextBlock Text="{Binding CategoryName, StringFormat='Категория: {0}'}" Foreground="DarkGray"/>
                            <TextBlock Text="{Binding AverageRating, StringFormat='Рейтинг: {0:0.0} ⭐'}" Foreground="Orange" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StockQuantity, StringFormat='В наличии: {0} шт.'}" Foreground="Gray" HorizontalAlignment="Right" Margin="0,5"/>
                            <Button Content="В корзину" Height="30" Margin="0,10,0,0" Click="BtnAddToCart_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>