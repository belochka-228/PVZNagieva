<Window x:Class="WPF_Nagieva.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <TabControl>
            <TabItem Header="Авторизация">
                <Border CornerRadius="8">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Введите логин:" Margin="0,20,0,5"/>
                        <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtPassword" Grid.Row="3" Height="30" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                        <Button Content="Войти" Height="35" Margin="0,0,0,10" Click="BtnLogin_Click" Background="#2C3E50" Foreground="White"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Регистрация">
                <Border CornerRadius="8">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Введите логин:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtLoginReg" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Введите пароль:" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtPasswordReg" Grid.Row="3" Height="30" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Повторите пароль:" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtPassword2Reg" Grid.Row="3" Height="30" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                        <Button Content="Зарегистрироваться" Height="35" Margin="0,0,0,10" Click="BtnReg_Click" Background="#2C3E50" Foreground="White"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        
    </Grid>
</Window>