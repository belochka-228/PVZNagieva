<Window x:Class="WPF_Nagieva.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин:" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtLogin" Grid.Row="1" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="TxtPassword" Grid.Row="3" Height="30" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="4">
            <Button Content="Войти" Height="35" Margin="0,0,0,10" Click="BtnLogin_Click"/>
            <Button Content="Зарегистрироваться" Height="35" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>