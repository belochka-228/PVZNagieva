<Window x:Class="WPF_Nagieva.Pages.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Nagieva.Pages"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    <Grid Margin="10">
        <TabControl>

            <TabItem Header="Добавить товар">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Цена:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPrice" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDesc" Grid.Row="2" Grid.Column="1" Height="60" TextWrapping="Wrap" Margin="0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Картинка (имя файла):" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtImage" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,5" Text="default.jpg"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ID Категории:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCategoryId" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,5" Text="1"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Кол-во на складе:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtStock" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,5" Text="10"/>

                    <CheckBox x:Name="ChkIsAvailable" Grid.Row="6" Grid.Column="1" Content="Доступен для покупки" IsChecked="True" Margin="0,5"/>

                    <Button Grid.Row="7" Grid.Column="1" Content="Создать товар" Height="40" Width="200" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#E8F5E9" Click="BtnCreateProduct_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Управление заказами">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Все заказы пользователей:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <ListView x:Name="LvAllOrders" Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" Width="800">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status, StringFormat='Текущий статус: {0}'}" Foreground="DarkGreen"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Выберите новый статус:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CbNewStatus" Width="200" Height="30">
                            <ComboBoxItem Content="Оформлен"/>
                            <ComboBoxItem Content="В обработке"/>
                            <ComboBoxItem Content="Передан в доставку"/>
                            <ComboBoxItem Content="Готов к выдаче"/>
                            <ComboBoxItem Content="Получен"/>
                            <ComboBoxItem Content="Отменён"/>
                        </ComboBox>
                        <Button Content="Изменить статус" Height="30" Width="150" Margin="10,0,0,0" Click="BtnChangeStatus_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Добавить ПВЗ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название ПВЗ:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPpName" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Адрес:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPpAddress" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,5"/>

                    <Button Grid.Row="2" Grid.Column="1" Content="Создать ПВЗ" Height="40" Width="200" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#E3F2FD" Click="BtnCreatePickupPoint_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Добавить категорию">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="93*"/>
                        <ColumnDefinition Width="511*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Название категории:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCategoryName" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,5,0,5" Grid.ColumnSpan="2"/>

                    <Button Grid.Row="1" Grid.Column="1" Content="Создать категорию" Height="40" Width="200" HorizontalAlignment="Left" Margin="0,153,0,133" Background="#FFF9C4" Click="BtnCreateCategory_Click" Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
